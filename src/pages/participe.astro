---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Faça parte">
  <section class="join-page section">
    <div class="container join-grid">
      <div data-reveal="left">
        <p class="eyebrow">Entre para a comunidade</p>
        <h1 class="display">Conecte-se. Colabore. Transforme.</h1>
        <p class="lead">
          Acompanhe processos seletivos, participe de projetos, receba oportunidades e desenvolva novas habilidades com a LASI.
        </p>

        <div class="join-options">
          <a class="panel join-option" href={`${base}/links/#whatsapp-qr`}>
            <span>01</span>
            <div><strong>Grupo de avisos</strong><small>Oportunidades, eventos e comunicados.</small></div>
            <b>↗</b>
          </a>
          <a class="panel join-option" href={site.social.instagram} target="_blank" rel="noopener noreferrer">
            <span>02</span>
            <div><strong>Instagram</strong><small>Projetos, resultados e bastidores.</small></div>
            <b>↗</b>
          </a>
          <a class="panel join-option" href={`${base}/processos-seletivos/`}>
            <span>03</span>
            <div><strong>Processos seletivos</strong><small>Editais, inscrições e novidades da LASI.</small></div>
            <b>→</b>
          </a>
        </div>
      </div>

      <div class="join-visual panel" data-reveal="right">
        <img src={`${base}/brand/horse.png`} alt="" data-float />
        <p>A próxima oportunidade pode começar com a sua ideia.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .join-page {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: 9rem;
  }

  .join-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
  }

  .join-options {
    display: grid;
    gap: 0.8rem;
    margin-top: 2.5rem;
  }

  .join-option {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .join-option:hover {
    border-color: rgba(177,107,209,0.5);
    transform: translateX(6px);
  }

  .join-option > span {
    color: var(--violet-400);
    font-weight: 800;
  }

  .join-option div {
    display: grid;
    gap: 0.25rem;
  }

  .join-option small {
    color: var(--muted);
  }

  .join-option b {
    color: var(--violet-400);
  }

  .join-visual {
    position: relative;
    min-height: 40rem;
    min-width: 0;
    overflow: hidden;
    background: radial-gradient(circle at 50% 42%, rgba(148,81,184,0.38), transparent 56%);
  }

  .join-visual img {
    position: absolute;
    top: 8%;
    left: 50%;
    width: min(24rem, 76%);
    transform: translateX(-50%);
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.5));
  }

  .join-visual p {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.45rem, 2.4vw, 2.4rem);
    line-height: 0.98;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  @media (max-width: 820px) {
    .join-grid {
      grid-template-columns: 1fr;
    }

    .join-visual {
      min-height: 32rem;
    }
  }

  @media (max-width: 540px) {
    .join-visual {
      min-height: 24rem;
    }
  }
</style>