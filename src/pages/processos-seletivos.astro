---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { selectionProcess } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Processo seletivo aberto">
  <section class="selection-hero section">
    <div class="container selection-hero-grid">
      <div data-reveal="left">
        <p class="eyebrow">LASI · UFAC</p>
        <h1 class="display">Processo seletivo aberto.</h1>
        <p class="lead">{selectionProcess.description}</p>
        <div class="button-row">
          <a class="button" href={selectionProcess.registrationUrl} target="_blank" rel="noreferrer">Inscreva-se agora <span>↗</span></a>
          <a class="button button--ghost" href={`${base}/links/#whatsapp-qr`}>Entrar no grupo de avisos</a>
        </div>
      </div>

      <aside class="panel deadline-card" data-reveal="right">
        <span class="deadline-index">2026</span>
        <p class="eyebrow">{selectionProcess.status}</p>
        <h2>Faça parte da LASI.</h2>
        <div class="deadline">
          <span>Prazo de inscrições</span>
          <strong>{selectionProcess.period}</strong>
        </div>
        <a class="text-link" href={selectionProcess.registrationUrl} target="_blank" rel="noreferrer">Abrir formulário <span>↗</span></a>
      </aside>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <SectionHeading eyebrow="Áreas de atuação" title="Escolha onde sua ideia pode crescer." outline="Eixos" />
      <div class="areas-grid">
        {selectionProcess.areas.map((area, index) => (
          <article class="panel area-card" data-reveal>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <b aria-hidden="true">{area.icon}</b>
            <h2>{area.title}</h2>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container selection-details">
      <div>
        <p class="eyebrow">Quem pode participar</p>
        <h2 class="display display--medium">Tem espaço para você.</h2>
      </div>
      <div class="profiles-grid">
        {selectionProcess.profiles.map((profile, index) => (
          <article class="panel profile-card" data-reveal>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{profile.title}</h3>
            <p>{profile.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="panel statute-card" data-reveal>
        <div>
          <p class="eyebrow">Antes de se inscrever</p>
          <h2>Leia o Estatuto da LASI.</h2>
          <p>{selectionProcess.statuteNotice}</p>
        </div>
        <a class="button" href={selectionProcess.registrationUrl} target="_blank" rel="noreferrer">Ir para inscrição <span>↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .selection-hero { min-height: 82svh; display: grid; align-items: center; padding-top: 10rem; }
  .selection-hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .selection-hero .lead { max-width: 56ch; }
  .selection-hero .button-row { margin-top: 2rem; }
  .deadline-card { position: relative; min-height: 31rem; display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.8rem, 5vw, 3.5rem); overflow: hidden; background: radial-gradient(circle at 100% 10%, rgba(148,81,184,0.34), transparent 17rem), rgba(255,255,255,0.035); }
  .deadline-index { position: absolute; top: 0.7rem; right: 1.2rem; color: rgba(255,255,255,0.14); font-family: var(--display); font-size: clamp(4rem, 9vw, 8rem); line-height: 1; }
  .deadline-card h2 { max-width: 8ch; margin: 0; font-family: var(--display); font-size: clamp(2.6rem, 5vw, 5.2rem); line-height: 0.88; text-transform: uppercase; }
  .deadline { display: grid; gap: 0.55rem; margin-top: auto; padding-top: 2rem; }
  .deadline span { color: var(--violet-400); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .deadline strong { max-width: 28ch; font-size: 1.05rem; line-height: 1.45; }
  .text-link { display: inline-flex; gap: 0.55rem; margin-top: 1.5rem; color: var(--violet-400); font-weight: 800; text-transform: uppercase; }
  .areas-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .area-card { min-height: 17rem; display: flex; flex-direction: column; padding: 1.5rem; }
  .area-card > span, .profile-card > span { color: var(--violet-400); font-size: 0.75rem; font-weight: 800; }
  .area-card b { margin: auto 0 1rem; font-size: clamp(1.6rem, 5vw, 2.2rem); }
  .area-card h2 { margin: 0; font-family: var(--display); font-size: clamp(1.65rem, 3vw, 2.6rem); line-height: 0.95; text-transform: uppercase; }
  .selection-details { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .profiles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .profile-card { min-height: 15rem; display: flex; flex-direction: column; padding: 1.5rem; }
  .profile-card h3 { margin: auto 0 0.7rem; font-family: var(--display); font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 0.95; text-transform: uppercase; }
  .profile-card p, .statute-card > div > p:not(.eyebrow) { margin: 0; color: var(--muted); line-height: 1.65; }
  .statute-card { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.8rem, 5vw, 3.5rem); background: radial-gradient(circle at 90% 20%, rgba(8,93,163,0.28), transparent 18rem), rgba(255,255,255,0.035); }
  .statute-card h2 { margin: 0; font-family: var(--display); font-size: clamp(2rem, 4vw, 3.8rem); line-height: 0.92; text-transform: uppercase; }
  @media (max-width: 900px) { .selection-hero-grid, .selection-details { grid-template-columns: 1fr; } .deadline-card { min-height: 25rem; max-width: 38rem; } }
  @media (max-width: 640px) { .areas-grid, .profiles-grid { grid-template-columns: 1fr; } .statute-card { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 540px) { .selection-hero { min-height: auto; padding-top: 6rem; } .deadline-card { min-height: 20rem; } }
</style>