---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  ['Sobre', '/sobre/'],
  ['Áreas', '/areas/'],
  ['Projetos', '/projetos/'],
  ['Eventos', '/eventos/'],
  ['Processos seletivos', '/processos-seletivos/'],
  ['Diretoria', '/diretoria/']
];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={`${base}/`} aria-label="Página inicial da LASI">
      <img src={`${base}/brand/mark-lasi.png`} alt="" width="46" height="46" />
      <span>
        <strong>LASI</strong>
        <small>UFAC</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>
      <span class="sr-only">Abrir menu</span>
      <span></span>
      <span></span>
    </button>

    <nav id="main-nav" class="main-nav" aria-label="Navegação principal" data-menu>
      {links.map(([label, href]) => (
        <a href={`${base}${href}`}>{label}</a>
      ))}
      <a class="button button--small" href={`${base}/participe/`} data-magnetic>Faça parte</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 60;
    inset: 0 0 auto;
    padding: 0.75rem 0;
    transition: background 220ms ease, border-color 220ms ease, backdrop-filter 220ms ease;
  }

  .site-header.is-scrolled {
    border-bottom: 1px solid var(--line);
    background: rgba(2, 9, 30, 0.78);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .brand img {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
    filter: drop-shadow(0 0 18px rgba(148, 81, 184, 0.22));
  }

  .brand span {
    display: grid;
    line-height: 1;
  }

  .brand strong {
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: -0.04em;
  }

  .brand small {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .main-nav > a:not(.button) {
    position: relative;
    color: #d7dfef;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .main-nav > a:not(.button)::after {
    position: absolute;
    right: 0;
    bottom: -0.4rem;
    left: 0;
    height: 2px;
    content: '';
    background: var(--violet-400);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .main-nav > a:hover::after,
  .main-nav > a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-toggle {
    display: none;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255,255,255,0.04);
  }

  .menu-toggle span:not(.sr-only) {
    display: block;
    width: 1.15rem;
    height: 2px;
    margin: 0.28rem auto;
    background: var(--white);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 1020px) {
    .menu-toggle {
      display: block;
    }

    .main-nav {
      position: absolute;
      top: calc(100% + 0.35rem);
      right: 1rem;
      left: 1rem;
      display: grid;
      padding: 1.2rem;
      border: 1px solid var(--line);
      border-radius: 1.25rem;
      background: rgba(2, 9, 30, 0.96);
      box-shadow: var(--shadow);
      transform: translateY(-0.5rem);
      opacity: 0;
      pointer-events: none;
    }

    .main-nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .main-nav .button {
      margin-top: 0.45rem;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const button = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-menu]');

  const updateHeader = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  };

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('is-open', !open);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      button?.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
    });
  });
</script>
