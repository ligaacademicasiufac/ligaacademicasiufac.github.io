---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { selectionProcess } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Processos seletivos">
  <section class="selection-hero section">
    <div class="container selection-hero-grid">
      <div data-reveal="left">
        <p class="eyebrow">LASI · UFAC</p>
        <h1 class="display">Nenhum processo seletivo aberto.</h1>
        <p class="lead">{selectionProcess.description}</p>
        <div class="button-row">
          <a class="button" href={`${base}/links/#whatsapp-qr`}>Entrar no grupo de avisos <span>↗</span></a>
          <a class="button button--ghost" href={`${base}/participe/`}>Outras formas de acompanhar</a>
        </div>
      </div>

      <aside class="panel status-card" data-reveal="right">
        <span class="status-index">LASI</span>
        <p class="eyebrow">{selectionProcess.status}</p>
        <h2>Fique de olho nos canais oficiais.</h2>
        <p>
          Novas chamadas são publicadas quando houver processo seletivo vigente. Esta página não mantém inscrições permanentes.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <SectionHeading eyebrow="Eixos temáticos" title="Onde a comunidade estuda e constrói." outline="Eixos" />
      <div class="areas-grid">
        {selectionProcess.areas.map((area, index) => (
          <article class="panel area-card" data-reveal>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <b aria-hidden="true">{area.icon}</b>
            <h2>{area.title}</h2>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container selection-details">
      <div>
        <p class="eyebrow">Participação</p>
        <h2 class="display display--medium">Quem pode integrar a LASI.</h2>
      </div>
      <div class="profiles-grid">
        {selectionProcess.profiles.map((profile, index) => (
          <article class="panel profile-card" data-reveal>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{profile.title}</h3>
            <p>{profile.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .selection-hero { min-height: 82svh; display: grid; align-items: center; padding-top: 10rem; }
  .selection-hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .selection-hero .lead { max-width: 56ch; }
  .selection-hero .button-row { margin-top: 2rem; }
  .status-card { position: relative; min-height: 29rem; display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.8rem, 5vw, 3.5rem); overflow: hidden; background: radial-gradient(circle at 100% 10%, rgba(8,93,163,0.3), transparent 17rem), rgba(255,255,255,0.035); }
  .status-index { position: absolute; top: 0.7rem; right: 1.2rem; color: rgba(255,255,255,0.1); font-family: var(--display); font-size: clamp(4rem, 9vw, 8rem); line-height: 1; }
  .status-card h2 { max-width: 11ch; margin: 0; font-family: var(--display); font-size: clamp(2.2rem, 4.5vw, 4.4rem); line-height: 0.92; text-transform: uppercase; }
  .status-card > p:last-child { max-width: 42ch; margin: auto 0 0; color: var(--muted); line-height: 1.65; }
  .areas-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .area-card { min-height: 17rem; display: flex; flex-direction: column; padding: 1.5rem; }
  .area-card > span, .profile-card > span { color: var(--violet-400); font-size: 0.75rem; font-weight: 800; }
  .area-card b { margin: auto 0 1rem; font-size: clamp(1.6rem, 5vw, 2.2rem); }
  .area-card h2 { margin: 0; font-family: var(--display); font-size: clamp(1.65rem, 3vw, 2.6rem); line-height: 0.95; text-transform: uppercase; }
  .selection-details { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .profiles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .profile-card { min-height: 15rem; display: flex; flex-direction: column; padding: 1.5rem; }
  .profile-card h3 { margin: auto 0 0.7rem; font-family: var(--display); font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 0.95; text-transform: uppercase; }
  .profile-card p { margin: 0; color: var(--muted); line-height: 1.65; }
  @media (max-width: 900px) { .selection-hero-grid, .selection-details { grid-template-columns: 1fr; } .status-card { min-height: 24rem; max-width: 38rem; } }
  @media (max-width: 640px) { .areas-grid, .profiles-grid { grid-template-columns: 1fr; } }
  @media (max-width: 540px) { .selection-hero { min-height: auto; padding-top: 6rem; } .status-card { min-height: 20rem; } }
</style>