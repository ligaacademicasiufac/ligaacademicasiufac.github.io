---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AchievementStats from '../components/AchievementStats.astro';
import { ecoHackWinners } from '../data/site';
---

<BaseLayout title="Conquistas">
  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">Trajetória</p>
      <h1 class="display">Resultados que movem a comunidade.</h1>
      <p class="lead">Números, premiações e marcos que registram o crescimento da LASI.</p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <AchievementStats />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Destaque" title="Amazon Eco-Hack." outline="Campeões" />
      <div class="podium">
        {ecoHackWinners.map((winner, index) => (
          <article class="panel podium-card" data-reveal>
            <span>{index === 0 ? '🏆' : '◆'}</span>
            <p>{winner.track}</p>
            <h2>{winner.project}</h2>
            <strong>{winner.team}</strong>
            <b>{winner.prize}</b>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: 10rem;
  }

  .podium {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 1rem;
    align-items: end;
  }

  .podium-card {
    min-height: 24rem;
    padding: 1.4rem;
  }

  .podium-card:first-child {
    min-height: 30rem;
    border-color: rgba(177,107,209,0.5);
    background: radial-gradient(circle at 50% 30%, rgba(148,81,184,0.24), transparent 55%), rgba(255,255,255,0.03);
  }

  .podium-card > span {
    font-size: 2rem;
  }

  .podium-card p {
    margin-top: 5rem;
    color: var(--violet-400);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .podium-card h2 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .podium-card strong,
  .podium-card b {
    display: block;
    margin-top: 1rem;
  }

  .podium-card strong {
    color: var(--muted);
  }

  .podium-card b {
    color: var(--violet-400);
  }

  @media (max-width: 820px) {
    .podium {
      grid-template-columns: 1fr;
    }

    .podium-card,
    .podium-card:first-child {
      min-height: 22rem;
    }
  }
</style>
