---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featuredEvent = (await getCollection('events')).find((event) => event.data.featured);
const linkItems = [
  { label: 'Entrar no grupo de avisos', href: `${base}/whatsapp/`, icon: '↗', primary: true },
  { label: 'Instagram', href: `${base}/instagram/`, icon: '↗', external: true },
  { label: 'LinkedIn', href: `${base}/linkedin/`, icon: '↗', external: true },
  { label: 'YouTube', href: `${base}/youtube/`, icon: '↗', external: true },
  { label: 'Conhecer a LASI', href: `${base}/sobre/`, icon: '→' },
  { label: 'Projetos e iniciativas', href: `${base}/projetos/`, icon: '→' },
  { label: 'Eventos e oportunidades', href: `${base}/eventos/`, icon: '→' },
  { label: 'Áreas de estudo', href: `${base}/areas/`, icon: '→' },
  { label: 'Diretoria 2026', href: `${base}/diretoria/`, icon: '→' }
];
---

<BaseLayout title="Links da LASI" hideHeader={true}>
  <section class="links-page">
    <div class="links-shell">
      <header class="links-header" data-reveal>
        <img src={`${base}/brand/logo-lasi.png`} alt="Logo da LASI" />
        <p class="eyebrow">Liga Acadêmica de Sistemas de Informação</p>
        <h1>LASI</h1>
        <span>{site.tagline}</span>
      </header>

      {featuredEvent && (
        <section class="featured-link" data-reveal>
          <a class="local-link-card" href={featuredEvent.data.externalUrl ?? `${base}/eventos/${featuredEvent.id}/`} target={featuredEvent.data.externalUrl ? '_blank' : undefined} rel={featuredEvent.data.externalUrl ? 'noopener noreferrer' : undefined}>
            <span class="local-link-kicker">Evento em destaque · 21 SET</span>
            <strong><span>.LOCAL</span>26</strong>
            <small>RIO BRANCO · UFAC · 18:30</small>
            <b>{featuredEvent.data.ctaLabel ?? 'Ver evento'} ↗</b>
          </a>
          <a class="local-detail-link" href={`${base}/eventos/${featuredEvent.id}/`}>Ver detalhes do evento →</a>
        </section>
      )}

      <nav class="links-list" aria-label="Links principais">
        {linkItems.map((item) => (
          <a
            class:list={['link-card panel', { 'link-card--primary': item.primary }]}
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            data-reveal
          >
            <span>{item.label}</span>
            <b>{item.icon}</b>
          </a>
        ))}
      </nav>

      <section id="whatsapp-qr" class="qr-panel panel" data-reveal>
        <p class="eyebrow">Grupo de avisos</p>
        <h2>Escaneie e entre na comunidade.</h2>
        <img src={`${base}/social/whatsapp-qr.png`} alt="QR Code do grupo de avisos da LASI no WhatsApp" />
        <small>
          Aponte a câmera para entrar no grupo de avisos da LASI.
        </small>
      </section>

      <footer class="links-footer">
        <a href={`${base}/`}>Abrir site institucional →</a>
        <span>IA e Dados · Engenharia de Software · Infraestrutura e Redes</span>
      </footer>
    </div>
  </section>
</BaseLayout>

<style>
  .links-page {
    min-height: 100svh;
    padding: 3rem 1rem;
    background:
      radial-gradient(circle at 50% 12%, rgba(148,81,184,0.24), transparent 22rem),
      linear-gradient(160deg, var(--ink-1000), var(--ink-900));
  }

  .links-shell {
    width: min(42rem, 100%);
    margin-inline: auto;
  }

  .links-header {
    text-align: center;
  }

  .links-header img {
    width: 7.5rem;
    height: 7.5rem;
    margin-inline: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 55px rgba(0,0,0,0.45));
  }

  .links-header .eyebrow {
    justify-content: center;
    margin-top: 1.2rem;
  }

  .links-header h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(4.8rem, 18vw, 8rem);
    line-height: 0.8;
  }

  .links-header > span {
    display: block;
    margin-top: 1rem;
    color: var(--muted);
  }

  .featured-link {
    display: grid;
    gap: 0.7rem;
    margin-top: 2.4rem;
  }

  .local-link-card {
    position: relative;
    display: grid;
    min-height: 13rem;
    align-content: end;
    gap: 0.45rem;
    padding: 1.25rem;
    overflow: hidden;
    border: 1px solid rgba(0,176,111,0.55);
    color: #fff;
    background:
      radial-gradient(circle at 90% 15%, rgba(0,176,111,0.22), transparent 9rem),
      radial-gradient(circle at 0% 100%, rgba(255,95,0,0.2), transparent 12rem),
      #080808;
    box-shadow: 12px 12px 0 rgba(255,95,0,0.18);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .local-link-card::before {
    position: absolute;
    top: -3rem;
    right: -3rem;
    width: 10rem;
    height: 10rem;
    border: 2px solid rgba(0,176,111,0.22);
    content: '';
    transform: rotate(26deg);
  }

  .local-link-card:hover,
  .local-link-card:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 15px 15px 0 rgba(255,95,0,0.24);
  }

  .local-link-kicker {
    color: #00b06f;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .local-link-card strong {
    font-family: var(--display);
    font-size: clamp(3rem, 11vw, 5rem);
    line-height: 0.82;
    letter-spacing: -0.07em;
  }

  .local-link-card strong span {
    color: #00b06f;
  }

  .local-link-card small {
    color: #d0d0d0;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .local-link-card b {
    margin-top: 0.5rem;
    color: #ff6a0a;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .local-detail-link {
    justify-self: end;
    color: #00b06f;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .links-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }

  .link-card {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.15rem;
    font-weight: 800;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .link-card:hover {
    border-color: rgba(177,107,209,0.58);
    transform: translateY(-3px);
  }

  .link-card--primary {
    border-color: rgba(177,107,209,0.55);
    background: linear-gradient(135deg, rgba(148,81,184,0.55), rgba(8,93,163,0.45));
  }

  .link-card b {
    color: var(--violet-400);
  }

  .link-card--primary b {
    color: var(--white);
  }

  .qr-panel {
    margin-top: 1.6rem;
    padding: 1.5rem;
    text-align: center;
  }

  .qr-panel .eyebrow {
    justify-content: center;
  }

  .qr-panel h2 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.8rem, 6vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .qr-panel img {
    width: min(22rem, 100%);
    margin: 1.4rem auto;
    border-radius: 1rem;
    background: white;
  }

  .qr-panel small {
    color: var(--muted);
    line-height: 1.5;
  }

  .links-footer {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .links-footer a {
    color: var(--violet-400);
    font-weight: 800;
  }

  @media (prefers-reduced-motion: reduce) {
    .local-link-card,
    .link-card {
      transition: none;
    }
  }
</style>
