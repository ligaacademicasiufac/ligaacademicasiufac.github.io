---
interface Event {
  id: string;
  data: {
    shortTitle: string;
    date: string;
    type: string;
    status: string;
    summary: string;
    cover?: string;
    theme?: 'lasi' | 'linuxtips-local';
    featured?: boolean;
  };
}

interface Props {
  events: Event[];
}

const { events } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="timeline">
  {events.map((event, index) => (
    <article class:list={['timeline-item', { 'timeline-item--local': event.data.theme === 'linuxtips-local' }]} data-reveal>
      <div class="timeline-marker">
        <span>{String(index + 1).padStart(2, '0')}</span>
      </div>
      <a class="timeline-card panel" href={`${base}/eventos/${event.id}/`}>
        <div class="timeline-copy">
          <div class="timeline-meta">
            <span>{event.data.date}</span>
            <span>{event.data.type}</span>
            <span>{event.data.status === 'concluido' ? 'Concluído' : event.data.status === 'aberto' ? 'Inscrições abertas' : 'Planejado'}</span>
          </div>
          <h3>{event.data.shortTitle}</h3>
          <p>{event.data.summary}</p>
          <b>Ver evento <span>↗</span></b>
        </div>
        <div class="timeline-cover">
          {event.data.cover ? (
            <img src={`${base}${event.data.cover}`} alt="" loading="lazy" />
          ) : event.data.theme === 'linuxtips-local' ? (
            <div class="local-cover" aria-hidden="true">
              <small>RIO BRANCO_</small>
              <strong><span>.LOCAL</span>26</strong>
              <em>21/09</em>
            </div>
          ) : (
            <div class="fallback-cover" aria-hidden="true">LASI</div>
          )}
        </div>
      </a>
    </article>
  ))}
</div>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .timeline::before {
    position: absolute;
    top: 1.6rem;
    bottom: 1.6rem;
    left: 1.75rem;
    width: 1px;
    content: '';
    background: linear-gradient(var(--violet-400), rgba(69,214,255,0.4), transparent);
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
  }

  .timeline-marker {
    position: relative;
    z-index: 2;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid rgba(177,107,209,0.5);
    border-radius: 50%;
    background: var(--ink-900);
    box-shadow: 0 0 28px rgba(148,81,184,0.2);
  }

  .timeline-marker span {
    color: var(--violet-400);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .timeline-card {
    display: grid;
    grid-template-columns: 1fr 10rem;
    gap: 1rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .timeline-card:hover {
    border-color: rgba(177,107,209,0.55);
    transform: translateX(4px);
  }

  .timeline-item--local .timeline-marker {
    border-color: rgba(0,176,111,0.65);
    box-shadow: 0 0 28px rgba(0,176,111,0.18);
  }

  .timeline-item--local .timeline-marker span,
  .timeline-item--local .timeline-meta,
  .timeline-item--local .timeline-card b {
    color: #00b06f;
  }

  .timeline-item--local .timeline-card:hover {
    border-color: rgba(0,176,111,0.58);
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--violet-400);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .timeline-meta span:not(:last-child)::after {
    margin-left: 0.6rem;
    content: '·';
    color: #66738f;
  }

  .timeline-card h3 {
    margin: 0.9rem 0 0.5rem;
    font-family: var(--display);
    font-size: clamp(1.6rem, 3vw, 2.7rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .timeline-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .timeline-card b {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1.1rem;
    color: var(--violet-400);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline-cover {
    align-self: stretch;
    min-height: 11rem;
    overflow: hidden;
    border-radius: 0.8rem;
    background: rgba(255,255,255,0.04);
  }

  .timeline-cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .local-cover,
  .fallback-cover {
    width: 100%;
    height: 100%;
    min-height: 11rem;
  }

  .local-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    overflow: hidden;
    color: #fff;
    background:
      linear-gradient(145deg, rgba(255,95,0,0.2), transparent 46%),
      linear-gradient(320deg, rgba(0,176,111,0.22), transparent 48%),
      #080808;
  }

  .local-cover::after {
    position: absolute;
    top: -2rem;
    right: -2rem;
    width: 7rem;
    height: 7rem;
    border: 2px solid rgba(0,176,111,0.25);
    content: '';
    transform: rotate(28deg);
  }

  .local-cover small {
    color: #00b06f;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .local-cover strong {
    font-family: var(--display);
    font-size: 1.7rem;
    line-height: 0.9;
  }

  .local-cover strong span {
    color: #00b06f;
  }

  .local-cover em {
    color: #ff5f00;
    font-size: 0.9rem;
    font-style: normal;
    font-weight: 900;
  }

  .fallback-cover {
    display: grid;
    place-items: center;
    color: rgba(255,255,255,0.18);
    font-family: var(--display);
    font-size: 2.8rem;
  }

  @media (max-width: 820px) {
    .timeline-card {
      grid-template-columns: 1fr;
    }

    .timeline-cover {
      min-height: 16rem;
    }

    .local-cover,
    .fallback-cover {
      min-height: 16rem;
    }
  }

  @media (max-width: 540px) {
    .timeline-item {
      grid-template-columns: 2.5rem 1fr;
      gap: 0.7rem;
    }

    .timeline::before {
      left: 1.25rem;
    }

    .timeline-marker {
      width: 2.5rem;
      height: 2.5rem;
    }

    .timeline-marker span {
      font-size: 0.62rem;
    }

    .timeline-cover,
    .local-cover,
    .fallback-cover {
      min-height: 12rem;
    }
  }
</style>