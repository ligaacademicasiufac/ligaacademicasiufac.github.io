---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventsTimeline from '../../components/EventsTimeline.astro';
import JoinSection from '../../components/JoinSection.astro';

const events = (await getCollection('events')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Eventos e oportunidades">
  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">Agenda LASI</p>
      <h1 class="display">Aprenda. Construa. Compita.</h1>
      <p class="lead">
        Hackathons, oficinas, palestras, mentorias e oportunidades para transformar conhecimento em experiência.
      </p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <SectionHeading eyebrow="Linha do tempo" title="Atividades e oportunidades." outline="Agenda" />
      <EventsTimeline events={events} />
    </div>
  </section>

  <JoinSection />
</BaseLayout>

<style>
  .page-hero {
    padding-top: 10rem;
  }
</style>
