---
interface Event {
  id: string;
  data: {
    shortTitle: string;
    date: string;
    type: string;
    status: string;
    summary: string;
    cover: string;
  };
}

interface Props {
  events: Event[];
}

const { events } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="timeline">
  {events.map((event, index) => (
    <article class="timeline-item" data-reveal>
      <div class="timeline-marker">
        <span>{String(index + 1).padStart(2, '0')}</span>
      </div>
      <a class="timeline-card panel" href={`${base}/eventos/${event.id}/`}>
        <div class="timeline-copy">
          <div class="timeline-meta">
            <span>{event.data.date}</span>
            <span>{event.data.type}</span>
            <span>{event.data.status === 'concluido' ? 'Concluído' : event.data.status === 'aberto' ? 'Aberto' : 'Planejado'}</span>
          </div>
          <h3>{event.data.shortTitle}</h3>
          <p>{event.data.summary}</p>
          <b>Ver evento <span>↗</span></b>
        </div>
        <div class="timeline-cover"><img src={`${base}${event.data.cover}`} alt="" loading="lazy" /></div>
      </a>
    </article>
  ))}
</div>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .timeline::before {
    position: absolute;
    top: 1.6rem;
    bottom: 1.6rem;
    left: 1.75rem;
    width: 1px;
    content: '';
    background: linear-gradient(var(--violet-400), rgba(69,214,255,0.4), transparent);
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
  }

  .timeline-marker {
    position: relative;
    z-index: 2;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid rgba(177,107,209,0.5);
    border-radius: 50%;
    background: var(--ink-900);
    box-shadow: 0 0 28px rgba(148,81,184,0.2);
  }

  .timeline-marker span {
    color: var(--violet-400);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .timeline-card {
    display: grid;
    grid-template-columns: 1fr 10rem;
    gap: 1rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .timeline-card:hover {
    border-color: rgba(177,107,209,0.55);
    transform: translateX(4px);
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--violet-400);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .timeline-meta span:not(:last-child)::after {
    margin-left: 0.6rem;
    content: '·';
    color: #66738f;
  }

  .timeline-card h3 {
    margin: 0.9rem 0 0.5rem;
    font-family: var(--display);
    font-size: clamp(1.6rem, 3vw, 2.7rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .timeline-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .timeline-card b {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1.1rem;
    color: var(--violet-400);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline-cover {
    align-self: stretch;
    min-height: 11rem;
    overflow: hidden;
    border-radius: 0.8rem;
    background: rgba(255,255,255,0.04);
  }

  .timeline-cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 820px) {
    .timeline-card {
      grid-template-columns: 1fr;
    }

    .timeline-cover {
      min-height: 16rem;
    }
  }
</style>
