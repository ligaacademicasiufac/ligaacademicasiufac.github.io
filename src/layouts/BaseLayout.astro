---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MotionScript from '../components/MotionScript.astro';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideHeader?: boolean;
}

const {
  title = site.fullName,
  description = site.description,
  image = '/social/og-cover.webp',
  hideHeader = false
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`${base}${image}`, Astro.site);
const fullTitle = title === site.fullName ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02091e" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}/brand/mark-lasi.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="cursor-glow" aria-hidden="true"></div>
    {!hideHeader && <Header />}
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <MotionScript />
  </body>
</html>
