---
import { achievements } from '../data/site';
---

<div class="stats-grid">
  {achievements.map((item) => (
    <article class="stat panel" data-reveal>
      <div>
        <span data-counter={item.value}>0</span><b>{item.suffix}</b>
      </div>
      <p>{item.label}</p>
    </article>
  ))}
</div>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .stat {
    min-height: 13rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.4rem;
    overflow: hidden;
  }

  .stat::before {
    position: absolute;
    inset: auto -25% -45% auto;
    width: 11rem;
    aspect-ratio: 1;
    border-radius: 50%;
    content: '';
    background: radial-gradient(circle, rgba(148,81,184,0.28), transparent 70%);
  }

  .stat > div {
    position: relative;
    font-family: var(--display);
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .stat b {
    color: var(--violet-400);
    font-size: 0.45em;
  }

  .stat p {
    position: relative;
    margin: 0.8rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
