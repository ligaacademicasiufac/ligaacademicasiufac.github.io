---
import BaseLayout from '../layouts/BaseLayout.astro';
import { selectionProcess, site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Processos seletivos">
  <section class="selection-page section">
    <div class="container selection-grid">
      <div data-reveal="left">
        <p class="eyebrow">Oportunidades na LASI</p>
        <h1 class="display">Processos seletivos.</h1>
        <p class="lead">Acompanhe aqui os editais, etapas e instruções para fazer parte da Liga.</p>
      </div>
      <article class="panel selection-status" data-reveal="right">
        <span>01</span>
        <p class="eyebrow">Status atual</p>
        <h2>{selectionProcess.status}</h2>
        <p>{selectionProcess.description}</p>
        <div class="button-row">
          <a class="button" href={`${base}/links/#whatsapp-qr`}>Entrar no grupo <span>↗</span></a>
          <a class="button button--ghost" href={site.instagram} target="_blank" rel="noreferrer">Acompanhar no Instagram</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .selection-page { min-height: 100svh; display: grid; align-items: center; padding-top: 9rem; }
  .selection-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .selection-status { position: relative; min-height: 29rem; display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.8rem, 5vw, 3.5rem); overflow: hidden; background: radial-gradient(circle at 88% 10%, rgba(148,81,184,0.3), transparent 17rem), rgba(255,255,255,0.035); }
  .selection-status > span { position: absolute; top: 1rem; right: 1.4rem; color: rgba(255,255,255,0.18); font-family: var(--display); font-size: 4rem; }
  .selection-status h2 { max-width: 12ch; margin: 0; font-family: var(--display); font-size: clamp(2.3rem, 5vw, 4.7rem); line-height: 0.9; text-transform: uppercase; }
  .selection-status > p:not(.eyebrow) { max-width: 54ch; color: var(--muted); line-height: 1.65; }
  .selection-status .button-row { margin-top: auto; }
  @media (max-width: 820px) { .selection-grid { grid-template-columns: 1fr; } }
</style>
