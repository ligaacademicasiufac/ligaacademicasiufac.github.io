---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AchievementStats from '../components/AchievementStats.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Conquistas">
  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">Trajetória</p>
      <h1 class="display">Resultados que movem a comunidade.</h1>
      <p class="lead">Premiações e marcos que registram o crescimento da LASI.</p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <AchievementStats />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Resultados" title="Cada evento deixa seu marco." outline="Eventos" />
      <div class="panel events-callout" data-reveal>
        <p>Confira os resultados, áreas envolvidas e comissão avaliadora em cada evento da LASI.</p>
        <a class="button" href={`${base}/eventos/`}>Explorar eventos <span>→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: 10rem;
  }

  .events-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .events-callout p {
    max-width: 58ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .events-callout {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 540px) {
    .page-hero {
      padding-top: 6rem;
    }
  }
</style>