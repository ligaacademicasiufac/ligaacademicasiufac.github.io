---
import { areas } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="area-network panel" data-area-network data-reveal>
  <svg class="area-lines" viewBox="0 0 1000 650" aria-hidden="true">
    <path d="M500 320 L500 90" data-area-line />
    <path d="M500 320 L180 515" data-area-line />
    <path d="M500 320 L820 515" data-area-line />
  </svg>

  <div class="area-core" data-pulse>
    <img src={`${base}/brand/mark-lasi.png`} alt="" width="160" height="160" />
    <span>Núcleo LASI</span>
  </div>

  {areas.map((area, index) => (
    <a
      class={`area-node area-node--${index + 1}`}
      href={`${base}/areas/${area.slug}/`}
      data-accent={area.accent}
    >
      <small>{area.index}</small>
      <strong>{area.shortTitle}</strong>
      <span>{area.description}</span>
      <i>Explorar área →</i>
    </a>
  ))}
</div>

<style>
  .area-network {
    position: relative;
    min-height: 42rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 48%, rgba(148, 81, 184, 0.2), transparent 23rem),
      linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01));
  }

  .area-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .area-lines path {
    fill: none;
    stroke: rgba(255,255,255,0.52);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .area-core {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: grid;
    width: 11rem;
    aspect-ratio: 1;
    place-items: center;
    padding: 1.2rem;
    border: 1px solid rgba(177, 107, 209, 0.55);
    border-radius: 50%;
    background: rgba(4, 14, 35, 0.82);
    box-shadow: 0 0 70px rgba(148,81,184,0.25);
    transform: translate(-50%, -50%);
  }

  .area-core img {
    width: 6rem;
    height: 6rem;
    object-fit: contain;
  }

  .area-core span {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .area-node {
    --accent: var(--violet-500);
    position: absolute;
    z-index: 3;
    display: grid;
    width: min(20rem, 34%);
    gap: 0.5rem;
    padding: 1.2rem;
    border: 1px solid color-mix(in srgb, var(--accent), transparent 60%);
    border-radius: 1.25rem;
    background: rgba(4, 14, 35, 0.86);
    box-shadow: 0 18px 50px rgba(0,0,0,0.3);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .area-node:hover {
    z-index: 5;
    border-color: var(--accent);
    box-shadow: 0 24px 70px color-mix(in srgb, var(--accent), transparent 78%);
    transform: translateY(-8px) scale(1.015);
  }

  .area-node small {
    color: var(--accent);
    font-weight: 800;
  }

  .area-node strong {
    font-family: var(--display);
    font-size: clamp(1.2rem, 2vw, 1.75rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .area-node span {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .area-node i {
    margin-top: 0.35rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 800;
    text-transform: uppercase;
  }

  .area-node--1 {
    top: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .area-node--1:hover {
    transform: translateX(-50%) translateY(-8px) scale(1.015);
  }

  .area-node--2 {
    bottom: 2.5rem;
    left: 3rem;
  }

  .area-node--3 {
    right: 3rem;
    bottom: 2.5rem;
  }

  @media (max-width: 760px) {
    .area-network {
      display: grid;
      min-height: auto;
      gap: 1rem;
      padding: 1rem;
    }

    .area-lines,
    .area-core {
      display: none;
    }

    .area-node {
      position: static;
      width: auto;
      transform: none;
    }

    .area-node:hover,
    .area-node--1:hover {
      transform: translateY(-4px);
    }
  }
</style>
