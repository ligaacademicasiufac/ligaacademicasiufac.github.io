---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AchievementStats from '../components/AchievementStats.astro';
import JoinSection from '../components/JoinSection.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Sobre a LASI">
  <section class="page-hero section">
    <div class="container grid-2">
      <div data-reveal="left">
        <p class="eyebrow">Conheça a LASI</p>
        <h1 class="display">Tecnologia feita em comunidade.</h1>
        <p class="lead">
          A Liga Acadêmica de Sistemas de Informação é uma entidade estudantil de caráter científico, educacional e extensionista, sem fins lucrativos, vinculada academicamente ao curso de Sistemas de Informação da UFAC e orientada pela integração entre ensino, pesquisa e extensão.
        </p>
      </div>
      <div class="about-logo panel" data-reveal="right">
        <img src={`${base}/brand/logo-lasi.png`} alt="Logo da Liga Acadêmica de Sistemas de Informação" />
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container institutional-note panel" data-reveal>
      <p class="eyebrow">Propósito institucional</p>
      <h2>Formação acadêmica conectada às demandas da sociedade acreana.</h2>
      <p>
        A LASI busca aprofundar conhecimentos teóricos e práticos em tecnologia, fomentar a produção científica discente, desenvolver ações extensionistas e fortalecer o protagonismo e a colaboração entre estudantes, pesquisadores e comunidade.
      </p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <SectionHeading eyebrow="Princípio de atuação" title="Aprender. Pesquisar. Compartilhar." outline="Objetivo" />
      <div class="purpose-grid">
        <article class="panel purpose-card" data-reveal>
          <span>01</span>
          <h2>Ensino</h2>
          <p>Aprofundamento teórico-prático, grupos de estudo, oficinas e atividades que complementam a formação acadêmica.</p>
        </article>
        <article class="panel purpose-card" data-reveal>
          <span>02</span>
          <h2>Pesquisa</h2>
          <p>Desenvolvimento de projetos e produção científica com método, experimentação e compromisso com a qualidade acadêmica.</p>
        </article>
        <article class="panel purpose-card" data-reveal>
          <span>03</span>
          <h2>Extensão</h2>
          <p>Ações que aproximam conhecimento computacional, universidade e sociedade por meio de projetos, eventos e iniciativas práticas.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <SectionHeading eyebrow="Trajetória" title="Uma liga construída por pessoas." outline="Comunidade" />
      <AchievementStats />
    </div>
  </section>

  <JoinSection />
</BaseLayout>

<style>
  .page-hero {
    padding-top: 10rem;
  }

  .about-logo {
    display: grid;
    min-height: 32rem;
    place-items: center;
    padding: 2rem;
    background:
      radial-gradient(circle, rgba(148,81,184,0.2), transparent 60%),
      rgba(255,255,255,0.03);
  }

  .about-logo img {
    width: min(28rem, 85%);
    filter: drop-shadow(0 30px 80px rgba(0,0,0,0.5));
  }

  .institutional-note {
    padding: clamp(1.8rem, 5vw, 3.5rem);
    background:
      radial-gradient(circle at 88% 15%, rgba(17,85,204,0.2), transparent 18rem),
      rgba(255,255,255,0.028);
  }

  .institutional-note h2 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .institutional-note > p:last-child {
    max-width: 70ch;
    margin: 1.2rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .purpose-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .purpose-card {
    min-height: 18rem;
    padding: 1.5rem;
  }

  .purpose-card > span {
    color: var(--violet-400);
    font-weight: 800;
  }

  .purpose-card h2 {
    margin: 4rem 0 0.75rem;
    font-family: var(--display);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    text-transform: uppercase;
  }

  .purpose-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .purpose-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .page-hero {
      padding-top: 6rem;
    }

    .about-logo {
      min-height: 20rem;
    }
  }
</style>